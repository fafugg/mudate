[Unit]
Description=Mudate - self-hosted real estate tracker
Documentation=file://%h/mudate/deploy/raspberry-pi.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mudate/backend

# No desktop environment: Chromium must never try to open a window.
Environment=PLAYWRIGHT_HEADLESS=1
Environment=PYTHONUNBUFFERED=1
Environment=DB_PATH=%h/mudate/data/db.json

# Optional overrides: OPENCAGE_API_KEY, PLAYWRIGHT_EXECUTABLE_PATH, ...
# Create the file with: install -m 600 /dev/null ~/.config/mudate.env
EnvironmentFile=-%h/.config/mudate.env

ExecStart=%h/mudate/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8010

Restart=on-failure
RestartSec=10

# A scrape is CPU/RAM hungry. Keep the rest of the Pi responsive.
Nice=5
# On a 4 GB Pi, cap the service so a runaway Chromium cannot take the board down:
# MemoryMax=3G

[Install]
WantedBy=default.target
